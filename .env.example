# Configuración de la aplicación Brecha Cambiaria

# Token del bot de Telegram (obtener de @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# URL de conexión a PostgreSQL (opcional, si no se configura usa archivos JSON)
DATABASE_URL=postgresql://usuario:password@host:puerto/database

# API key para el endpoint POST /api/refresh (header X-API-Key).
# Si no se configura, el endpoint queda deshabilitado (401).
REFRESH_API_KEY=una_clave_secreta_larga

# Service account de Firebase para push a Android (FCM).
# Puede ser el JSON inline o la ruta a un archivo .json.
# Si no se configura, las push a Android quedan deshabilitadas.
FIREBASE_SERVICE_ACCOUNT=/ruta/a/service-account.json

# Credenciales APNs para push a iOS (Apple Developer > Keys).
# APNS_KEY puede ser el contenido del .p8 inline o la ruta al archivo.
# Si no se configuran, las push a iOS quedan deshabilitadas.
APNS_TEAM_ID=TU_TEAM_ID
APNS_KEY_ID=TU_KEY_ID
APNS_KEY=/ruta/a/AuthKey_XXXXX.p8
APNS_TOPIC=com.brechacambiaria.app
# Usar el servidor sandbox de APNs (builds de desarrollo): true/false
APNS_USE_SANDBOX=false
